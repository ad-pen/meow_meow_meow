@page "/credentials"
@using jVision.Shared.Models
@using jVision.Shared
@using jVision.Client.Shared
@using System.Collections.Generic
@using System.Net.Http.Json
@using Microsoft.AspNetCore.SignalR.Client
@inject IJSRuntime _JSRuntime
@inject NavigationManager NavigationManager

<div class="row">
    <div class="col">
        <h2>Creds</h2>

        <div class="d-flex align-items-end" style="gap:12px; flex-wrap:wrap; margin-bottom:20px;">
            <div>
                <label for="type">Type</label>
                <select name="type" class="form-control custom-select" @bind="drop">
                    @foreach (var item in Enum.GetValues(typeof(cType)))
                    {
                        <option value="@item">@item</option>
                    }
                </select>
            </div>

            <div>
                <label>Mode</label>
                <select class="form-control custom-select"
                        value="@(_bulkMode ? "true" : "false")"
                        @onchange="OnModeChanged">
                    <option value="false">Single</option>
                    <option value="true">Bulk paste</option>
                </select>
            </div>

            @if (!_bulkMode)
            {
                <div>
                    <label>Credential</label>
                    <input placeholder="e.g. Administrator:Passw0rd!"
                           @bind="_credText" @bind:event="oninput" class="form-control" />
                </div>
            }

            <div style="flex:1; min-width:200px;">
                <label>Source</label>
                <input placeholder="obtained via SMB relay on 10.0.5.44"
                       @bind="_source" @bind:event="oninput" class="form-control" />
            </div>

            <div>
                <button class="btn btn-success" @onclick="AddOrBulk">Submit</button>
            </div>
        </div>

        @if (_bulkMode)
        {
            <div class="form-group">
                <label>Paste creds (one per line — Source above applies to all)</label>
                <textarea class="form-control" rows="6" placeholder="line1&#10;line2&#10;..."
                          value="@_bulkText" @oninput="OnBulkInput"></textarea>
                <small class="text-muted">
                    @(_bulkText?.Split('\n').Where(l => !string.IsNullOrWhiteSpace(l)).Count() ?? 0) non-empty line(s) ready to submit
                </small>
            </div>
        }

        @if (!string.IsNullOrEmpty(_status))
        {
            <div class="alert alert-success" style="margin-top:8px;">@_status</div>
        }
        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="alert alert-warning" style="margin-top:8px;">@_error</div>
        }
    </div>
</div>

<div class="row">
    @foreach (var col in _columns)
    {
        <div class="col">
            <div class="d-flex flex-row">
                <div class="p-1"><h4>@col.Label</h4></div>
                <div class="p-2">
                    <CopyToClipboard Large=false Text=@string.Join("\n", CredsOfType(col.Type).Select(c => c.Text)) />
                </div>
            </div>
            <div class="shadow boxie" style="padding:20px;">
                @foreach (var c in CredsOfType(col.Type))
                {
                    <div class="d-flex align-items-start" style="gap:6px; padding:4px 0; border-bottom:1px solid #eee;">
                        <div class="p-1">
                            <input type="checkbox" checked="@c.Verified"
                                   @onchange="@(e => ToggleVerified(c, (bool)e.Value))"
                                   title="mark verified (working)" />
                        </div>
                        <div class="p-1 mr-auto" style="min-width:0; word-break:break-all;">
                            <div style="@(c.Verified ? "font-weight:600;" : "")">@c.Text</div>
                            @if (!string.IsNullOrEmpty(c.Source))
                            {
                                <div class="text-muted"><small>@c.Source</small></div>
                            }
                        </div>
                        <div class="p-1">
                            <button class="btn btn-sm btn-outline-secondary" title="copy"
                                    @onclick="@(() => CopyOne(c.Text))">
                                <span class="oi oi-clipboard"></span>
                            </button>
                        </div>
                        <div class="p-1">
                            <button class="btn btn-sm btn-outline-danger" title="delete"
                                    @onclick="@(() => DeleteCred(c))">
                                <span class="oi oi-trash"></span>
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    [Inject] public HttpClient Http { get; set; }

    private List<Cred> creds = new();
    private string requestUri = "Creds";
    private HubConnection hubConnection;
    private string _error;
    private string _status;

    private string _credText;
    private string _source;
    private string _bulkText;
    private bool _bulkMode;

    // Explicit change handler for the Mode dropdown. `@bind` on <select value>
    // to a bool used to work only intermittently in Blazor 5 (the string→bool
    // converter would silently keep _bulkMode = false), leaving the textarea
    // hidden and Submit doing nothing.
    private void OnModeChanged(ChangeEventArgs e)
    {
        _bulkMode = e.Value?.ToString() == "true";
        _error = null;
        _status = null;
    }

    // Explicit oninput for the textarea. Same reasoning as above: default
    // @bind="_bulkText" only fires onchange (i.e. blur). A paste-then-immediate-
    // click would send an empty _bulkText and Submit did nothing.
    private void OnBulkInput(ChangeEventArgs e)
    {
        _bulkText = e.Value?.ToString() ?? "";
    }

    private record Column(string Label, string Type);
    private readonly Column[] _columns = new[]
    {
        new Column("Usernames", "Username"),
        new Column("Passwords", "Password"),
        new Column("Pairs",     "Pair"),
    };

    private enum cType { Username, Password, Pair }
    private cType drop = cType.Username;

    private IEnumerable<Cred> CredsOfType(string t) =>
        creds.Where(c => c != null && c.Type == t);

    protected override async Task OnInitializedAsync()
    {
        hubConnection = new HubConnectionBuilder().WithUrl(NavigationManager.ToAbsoluteUri("/boxhub")).Build();
        hubConnection.On<Cred>("CredAdded", t =>
        {
            creds.Add(t);
            InvokeAsync(StateHasChanged);
        });
        hubConnection.On<Cred>("CredUpdated", t =>
        {
            var existing = creds.FirstOrDefault(c => c.CredId == t.CredId);
            if (existing != null)
            {
                existing.Verified = t.Verified;
                existing.Source = t.Source;
                InvokeAsync(StateHasChanged);
            }
        });
        hubConnection.On<int>("CredDeleted", id =>
        {
            var yo = creds.FirstOrDefault(c => c.CredId == id);
            if (yo != null) creds.Remove(yo);
            InvokeAsync(StateHasChanged);
        });
        await hubConnection.StartAsync();
        try
        {
            creds = await Http.GetFromJsonAsync<List<Cred>>(requestUri);
        }
        catch (Exception) { _error = "Failed to load creds"; }
    }

    private async Task AddOrBulk()
    {
        _error = null;
        _status = null;
        try
        {
            if (_bulkMode)
            {
                var lines = (_bulkText ?? "")
                    .Split(new[] { '\n', '\r' }, StringSplitOptions.RemoveEmptyEntries)
                    .Select(l => l.Trim())
                    .Where(l => l.Length > 0)
                    .ToList();
                if (lines.Count == 0) { _error = "nothing pasted"; return; }
                var payload = lines.Select(l => new Cred
                {
                    Text = l, Type = drop.ToString(), Source = _source, Verified = false,
                }).ToList();
                var r = await Http.PostAsJsonAsync($"{requestUri}/bulk", payload);
                if (!r.IsSuccessStatusCode)
                {
                    var body = await r.Content.ReadAsStringAsync();
                    _error = $"bulk POST failed: {(int)r.StatusCode} {r.ReasonPhrase} — {body}";
                    return;
                }
                var added = await r.Content.ReadFromJsonAsync<int>();
                _status = $"queued {lines.Count} line(s) — server added {added} new ({lines.Count - added} deduped)";
                _bulkText = "";
            }
            else
            {
                if (string.IsNullOrWhiteSpace(_credText)) { _error = "empty credential"; return; }
                var newCred = new Cred
                {
                    Text = _credText.Trim(), Type = drop.ToString(),
                    Source = _source, Verified = false,
                };
                var r = await Http.PostAsJsonAsync(requestUri, newCred);
                if (!r.IsSuccessStatusCode)
                {
                    var body = await r.Content.ReadAsStringAsync();
                    _error = $"POST failed: {(int)r.StatusCode} {r.ReasonPhrase} — {body}";
                    return;
                }
                _credText = "";
            }
        }
        catch (Exception ex)
        {
            _error = "submit threw: " + ex.Message;
        }
    }

    private async Task ToggleVerified(Cred c, bool value)
    {
        c.Verified = value;
        await Http.PutAsJsonAsync($"{requestUri}/{c.CredId}", c);
    }

    private async Task CopyOne(string text)
    {
        // Route through the same clipboardCopy.copyText shim in index.html used
        // by the copy-all button. Calling navigator.clipboard.writeText via
        // JSRuntime string-path loses `this` binding and throws "Illegal invocation".
        try { await _JSRuntime.InvokeVoidAsync("clipboardCopy.copyText", text); }
        catch { /* best-effort */ }
    }

    private async Task DeleteCred(Cred c)
    {
        var response = await Http.DeleteAsync($"{requestUri}/{c.CredId}");
        if (!response.IsSuccessStatusCode) _error = response.ReasonPhrase;
    }

    public void Dispose()
    {
        _ = hubConnection?.DisposeAsync();
    }
}
